<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2D automation A3: AX-CAD .NET SDK (plan.md §20). No NuGet packages: HttpClient and
       System.Text.Json come with .NET 8. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AxCad</AssemblyName>
    <RootNamespace>AxCad</RootNamespace>
    <Version>3.0.0</Version>
    <!-- W8: a NuGet package (dotnet pack); the API follows Autodesk.AutoCAD.DatabaseServices / Geometry / EditorInput -->
    <PackageId>AxCad.Sdk</PackageId>
    <Authors>AX-CAD</Authors>
    <PackageTags>cad;dxf;autocad-net;rest</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Description>AX-CAD SDK: drive AX-CAD from C# through its REST API (drawings as an AutoCAD .NET-style Database: transactions, symbol tables, blocks, dictionaries, 3D features, sheet metal, assemblies, quotes).</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
