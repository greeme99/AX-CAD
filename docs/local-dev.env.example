# AX-CAD 로컬 개발 환경변수 템플릿 (Windows PC, 2026-11-13)
# 사용: 이 파일을 D:\Workspace\AX-CAD\.env 로 복사한 뒤 <...> 를 실제 값으로 바꾼다.
#   copy docs\local-dev.env.example .env
# .env 는 .gitignore 대상 — 커밋 금지. 값을 채팅·로그·문서에 붙이지 않는다.
# 서명 키 AXCAD_PATCH_KEY 는 여기에 두지 않는다(GitHub release 환경 전용).
# 줄 끝 # 주석은 값으로 읽힐 수 있으니 주석은 항상 별도 줄에 쓴다.

# ── 필수 ──────────────────────────────────────────────
# 개발 DB. 예: docker run -d --name axcad-dev-pg -e POSTGRES_USER=axcad
#   -e POSTGRES_PASSWORD=<DB_PASSWORD> -e POSTGRES_DB=axcad -p 5432:5432 postgres:16
DATABASE_URL=postgresql://axcad:<DB_PASSWORD>@localhost:5432/axcad

# 테스트 DB. 개발 DB와 분리하고 DB 이름은 반드시 _test 로 끝낸다
# (conftest 가 강제하며 실행마다 스키마를 지우고 다시 만든다).
#   docker exec axcad-dev-pg createdb -U axcad axcad_test
TEST_DATABASE_URL=postgresql://axcad:<DB_PASSWORD>@localhost:5432/axcad_test

# 로그인 토큰 서명 키. 생성:
#   uv run python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<RANDOM_SECRET>

# ── 선택 (줄 앞 # 을 지우고 값을 넣는다. 비워 두면 괄호 안 기본 동작) ──
# Copilot LLM(K-EXAONE) 키 (없으면 화면 설정에 저장한 키, 그것도 없으면 규칙 기반만)
# AXCAD_EXAONE_API_KEY=<EXAONE_API_KEY>

# 정식 견적서 공급자 정보 JSON, 저장소 밖 경로 권장 (없으면 샘플 backend/config/supplier.json)
# AXCAD_SUPPLIER_FILE=D:\AX-CAD-private\supplier.json

# DWG 변환기 실행 파일 절대 경로 (없으면 설치된 ODA File Converter 자동 탐지)
# AXCAD_DWG_CONVERTER=C:\Program Files\ODA\ODAFileConverter 26.10.0\ODAFileConverter.exe

# 업로드·3D 캐시 폴더 (없으면 저장소 var\)
# AXCAD_VAR_DIR=D:\Workspace\AX-CAD-var
