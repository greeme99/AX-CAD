{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "AX-CAD Design Tokens",
  "version": "1.0.0",
  "description": "Single Source of Truth design tokens for AX-CAD 2D/3D Web Workbench and SaaS Dashboard",
  "tokens": {
    "color": {
      "light": {
        "bgBase": "#f8fafc",
        "bgSurface": "#ffffff",
        "bgSubtle": "#f1f5f9",
        "bgHover": "#e2e8f0",
        "border": "#e2e8f0",
        "borderStrong": "#cbd5e1",
        "textMain": "#0f172a",
        "textBody": "#334155",
        "textMuted": "#64748b",
        "primary": "#0066ff",
        "primaryHover": "#0052cc",
        "primaryLight": "#e0edff",
        "primarySolid": "#0066ff",
        "primarySolidHover": "#0052cc",
        "successText": "#047857",
        "warningText": "#b45309",
        "dangerText": "#b91c1c"
      },
      "dark": {
        "bgBase": "#090d16",
        "bgSurface": "#111827",
        "bgSubtle": "#1f2937",
        "bgHover": "#374151",
        "border": "#1f2937",
        "borderStrong": "#374151",
        "textMain": "#f9fafb",
        "textBody": "#e5e7eb",
        "textMuted": "#9ca3af",
        "primary": "#3b82f6",
        "primaryHover": "#60a5fa",
        "primaryLight": "rgba(59, 130, 246, 0.15)",
        "primarySolid": "#2563eb",
        "primarySolidHover": "#1d4ed8",
        "successText": "#34d399",
        "warningText": "#fbbf24",
        "dangerText": "#f87171"
      },
      "cad": {
        "selection": {
          "light": "#2563eb",
          "dark": "#60a5fa"
        },
        "snap": {
          "light": "#10b981",
          "dark": "#34d399"
        },
        "warning": {
          "light": "#f59e0b",
          "dark": "#fbbf24"
        },
        "dimension": {
          "light": "#8b5cf6",
          "dark": "#a78bfa"
        },
        "canvas": {
          "darkBg": "#181b20",
          "darkFg": "#e5e7eb",
          "darkGrid": "rgba(255, 255, 255, 0.06)",
          "lightBg": "#ffffff",
          "lightFg": "#0f172a",
          "lightGrid": "rgba(0, 0, 0, 0.06)"
        }
      },
      "workbenches": {
        "sketch": { "accent": "#3b82f6", "light": "rgba(59, 130, 246, 0.12)" },
        "model": { "accent": "#0066ff", "light": "rgba(0, 102, 255, 0.12)" },
        "surface": { "accent": "#8b5cf6", "light": "rgba(139, 92, 246, 0.12)" },
        "assembly": { "accent": "#f59e0b", "light": "rgba(245, 158, 11, 0.12)" },
        "sheetmetal": { "accent": "#10b981", "light": "rgba(16, 185, 129, 0.12)" },
        "cam": { "accent": "#ef4444", "light": "rgba(239, 68, 68, 0.12)" },
        "drawing": { "accent": "#64748b", "light": "rgba(100, 116, 139, 0.12)" }
      }
    },
    "typography": {
      "fontFamily": {
        "sans": "\"Pretendard\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Noto Sans KR\", sans-serif",
        "mono": "\"JetBrains Mono\", \"Fira Code\", ui-monospace, monospace"
      },
      "fontSize": {
        "2xs": "0.625rem",
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem"
      },
      "fontWeight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "lineHeight": {
        "none": "1",
        "tight": "1.25",
        "snug": "1.375",
        "normal": "1.5",
        "relaxed": "1.625"
      }
    },
    "spacing": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "borderRadius": {
      "none": "0px",
      "xs": "2px",
      "sm": "4px",
      "md": "6px",
      "lg": "8px",
      "xl": "12px",
      "2xl": "16px",
      "pill": "9999px"
    },
    "shadow": {
      "cardLight": "0 4px 20px -2px rgba(15, 23, 42, 0.05)",
      "cardDark": "0 4px 20px -2px rgba(0, 0, 0, 0.5)",
      "cardHover": "0 10px 25px -3px rgba(0, 102, 255, 0.12)",
      "modal": "0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1)"
    },
    "transition": {
      "fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
      "normal": "200ms cubic-bezier(0.4, 0, 0.2, 1)",
      "smooth": "300ms cubic-bezier(0.4, 0, 0.2, 1)"
    }
  }
}
