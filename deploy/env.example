# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate secrets with: openssl rand -hex 32   (hex only: the password is part of the DB URL)

# required
POSTGRES_PASSWORD=
JWT_SECRET=

# proxy mode: https (production; certificate in deploy/config/tls/) or http (trial/UAT only)
AXCAD_PROXY=https
# ports on the server; HTTPS stays on 443 so the http->https redirect lands correctly
AXCAD_PORT=8080
AXCAD_TLS_PORT=443
# bind to the server's intranet address instead of every interface (Docker bypasses host firewalls)
# AXCAD_BIND=10.0.0.10
# API memory cap (two DXF parse workers may take up to 2 GB each)
# AXCAD_API_MEM=6g
# image tag written by `docker compose build` (bump per release to keep rollback images)
AXCAD_VERSION=latest

# official quotes: real supplier info, file placed in deploy/config/ (see backend/config/supplier.json)
# AXCAD_SUPPLIER_FILE=/config/supplier.json

# ERP (FN-24): https endpoint; the token is read from here only and never stored in the DB
# ERP_API_URL=
# ERP_API_TOKEN=

# closed network / internal registry: point the base images at your mirror.
# Reproducible builds: pin by digest, e.g. postgres:16@sha256:<digest> (docker buildx imagetools inspect)
# PYTHON_IMAGE=registry.example.local/library/python:3.13-slim-bookworm
# NODE_IMAGE=registry.example.local/library/node:22-bookworm-slim
# POSTGRES_IMAGE=registry.example.local/library/postgres:16
# NGINX_IMAGE=registry.example.local/library/nginx:1.28-alpine
