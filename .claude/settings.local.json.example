{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Windows 사용자의 경우 이 파일을 settings.local.json 으로 복사하여 아래 PowerShell 훅을 활성화하십시오.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude\\hooks\\guard-dangerous-command.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude\\hooks\\post-edit-check.ps1\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
