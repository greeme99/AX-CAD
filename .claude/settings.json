{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run ruff format --check*)",
      "Bash(uv run mypy*)",
      "Bash(uv run pytest*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm --dir frontend typecheck*)",
      "Bash(pnpm --dir frontend lint*)",
      "Bash(pnpm --dir frontend test*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(pnpm add*)",
      "Bash(pnpm --dir frontend add*)",
      "Bash(docker compose*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git push origin main*)",
      "Edit(./installer/**)",
      "Write(./installer/**)",
      "Edit(./deploy/**)",
      "Write(./deploy/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./pyproject.toml)",
      "Write(./pyproject.toml)",
      "Edit(./uv.lock)",
      "Write(./uv.lock)",
      "Edit(./frontend/package.json)",
      "Write(./frontend/package.json)",
      "Edit(./frontend/pnpm-lock.yaml)",
      "Write(./frontend/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-dangerous-command.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
